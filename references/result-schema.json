{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "fan_in",
    "workers",
    "validation",
    "changed_files",
    "risks",
    "next_actions"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "completed_with_warnings",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "fan_in": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "received",
        "complete"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "received": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vendor",
          "role",
          "status",
          "stream",
          "artifact",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "vendor": {
            "type": "string",
            "enum": [
              "codex",
              "grok"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "stalled",
              "skipped"
            ]
          },
          "stream": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 12
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
